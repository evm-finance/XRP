func (svc *XRPService) GetTokenList() ([]*models.XRPTokenFields, error) {

	var (
		url          = "https://s1.xrplmeta.org/tokens"
		tokenList    models.XRPTokenList
		allTokenData models.XRPTokensQuery
		count        int
	)

	resp, err := http.Get(url)

	if err != nil {
		return nil, err
	}

	defer func(Body io.ReadCloser) {
		err := Body.Close()
		if err != nil {
			log.BackgroundJobsLogger.Error("something went wrong while reading from request data", zap.Error(err))
		}
	}(resp.Body)

	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("received non-OK response: %s", resp.Status)
	}

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}

	err = json.Unmarshal(data, &tokenList)
	if err != nil {
		return nil, err
	}
	// TODO: optimize this loop
	for i := 0; i < 25; count++ {
		if tokenList.Tokens[count].Meta.Token.Name != "" {
			//fmt.Println("Token #", i, tokenList.Tokens[count].Meta.Token.Name, "Position in list:", count)
			allTokenData.Tokens = append(allTokenData.Tokens, &models.XRPTokenFields{
				Currency:      tokenList.Tokens[count].Currency,
				IssuerAddress: tokenList.Tokens[count].Issuer,
				Icon:          tokenList.Tokens[count].Meta.Token.Icon,
				TokenName:     tokenList.Tokens[count].Meta.Token.Name,
				IssuerName:    tokenList.Tokens[count].Meta.Issuer.Name,
				Marketcap:     tokenList.Tokens[count].Metrics.Marketcap,
				Price:         tokenList.Tokens[count].Metrics.Price,
				Volume24H:     tokenList.Tokens[count].Metrics.Volume24H,
			})
			i++
		}
	}

	return allTokenData.Tokens, nil
}

