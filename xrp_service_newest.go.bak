func (svc *XRPService) GetTokenData(ledgerIndex int, client *xrpl.Client) {
	url := "https://s1.xrplmeta.org/tokens"

	method := "GET"
	var tokenList models.XRPTokenList
	connection := &http.Client{}
	req, err := http.NewRequest(method, url, nil)

	if err != nil {
		fmt.Printf("ERROR %s\n", err)
	}

	response, err := connection.Do(req)
	fmt.Println(response)
	if err != nil {
		fmt.Printf("The HTTP request failed with error %s\n", err)
	}
	data, err := io.ReadAll(response.Body)

	if err != nil {
		fmt.Printf("ERROR %s\n", err)
	}

	json.Unmarshal(data, &tokenList)

	for i := 0; i < 25; i++ {
		fmt.Println(tokenList.Tokens[i])
		fmt.Println(tokenList.Tokens[i].Issuer)
		fmt.Println(tokenList.Tokens[i].Currency)

		fmt.Println(tokenList.Tokens[i].Metrics.Trustlines)
		fmt.Println(tokenList.Tokens[i].Metrics.Holders)
		fmt.Println(tokenList.Tokens[i].Metrics.Supply)
		fmt.Println(tokenList.Tokens[i].Metrics.Marketcap)
		fmt.Println(tokenList.Tokens[i].Metrics.Price)
		fmt.Println(tokenList.Tokens[i].Metrics.Volume24H)
		fmt.Println(tokenList.Tokens[i].Metrics.Volume7D)

		//fmt.Println(tokenList.Tokens[i].Meta)
		fmt.Println(tokenList.Tokens[i].Meta.Token.Name)
		fmt.Println(tokenList.Tokens[i].Meta.Token.Icon)
		fmt.Println(tokenList.Tokens[i].Meta.Token.Description)
		fmt.Println(tokenList.Tokens[i].Meta.Token.Weblinks)

		svc.GetAMMAccount(tokenList.Tokens[i].Currency, tokenList.Tokens[i].Issuer)

		// svc.GetPrice(ledgerIndex, client, tokenList.Tokens[i].Currency, tokenList.Tokens[i].Issuer)
	}
	//fmt.Println(data)
}

