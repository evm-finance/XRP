func (svc *XRPService) GetAMMAccount(currency string, issuer string) (string, error) {

	currency1 := map[string]string{"currency": "XRP"}
	currency2 := map[string]string{"currency": currency, "issuer": issuer}
	ammInfo := models.AMMInfo{}
	request := xrpl.BaseRequest{"command": "amm_info",
		"asset":  currency1,
		"asset2": currency2,
	}
	response, err := svc.client.Request(request)
	if err != nil {
		fmt.Println("error", err, request)
	}

	jsonStr, err := json.Marshal(response)
	if err != nil {
		fmt.Println(err)
	}
	fmt.Println(jsonStr, ammInfo)
	return "none", nil
}

