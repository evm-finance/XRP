func (svc *XRPService) GetAccountBalances(address string) (*models.XRPAccountBalances, error) {

	// rMjRc6Xyz5KHHDizJeVU63ducoaqWb1NSj
	//var result XRPTrustlinesResponse
	xrpBalancesResponse := models.XRPAccountBalances{}
	xrpTokenBalance := models.XRPBalanceElem{}
	trustlinesRequest := xrpl.BaseRequest{
		"id":           2,
		"command":      "account_lines",
		"account":      address,
		"ledger_index": "validated"}
	response, err := svc.client.Request(trustlinesRequest)
	xrpPrice := svc.FetchQcPrice("XRP")
	xrpBalancesResponse.XRPPrice = xrpPrice
	xrpBalancesResponse.Account = address
	xrpBalancesResponse.XRPBalance = 50
	fmt.Println(xrpPrice)
	//jsonStr, err := json.Marshal(response["result"])
	//fmt.Println(jsonStr)
	//err = json.Marshal(response, &result)

	//result = response
	//fmt.Println(value)
	if err != nil {

		fmt.Println(err)
		return nil, err
	} else {
		fmt.Println(response["result"])
		balanceMap, ok := response["result"].(map[string]interface{})
		if !ok {
			fmt.Println("error")
		}
		linesArray, ok := balanceMap["lines"].([]interface{})
		if !ok {
			fmt.Println(ok)
		}
		fmt.Println(linesArray)
		for i := 0; i < len(linesArray); i++ {
			fmt.Println(linesArray[i])
			elem := linesArray[i].(map[string]interface{})
			if !ok {
				fmt.Println(ok)
			}
			balanceFloat, err := strconv.ParseFloat(elem["balance"].(string), 64)
			if err != nil {
				fmt.Println(err)
			}
			//price, err := svc.GetPrice(client, elem["currency"].(string), elem["account"].(string))
			//if err != nil {
			//	fmt.Println(err)
			//}
			//price = price * xrpPrice
			//value := price * balanceFloat
			xrpTokenBalance.Issuer = elem["account"].(string)
			xrpTokenBalance.Balance = balanceFloat
			xrpTokenBalance.Symbol = elem["currency"].(string)
			//xrpTokenBalance.Price = price
			//xrpTokenBalance.Value = value
			xrpTokenBalance.Name = "token_name"
			fmt.Println(xrpTokenBalance)
			xrpBalancesResponse.XRPTokens = append(xrpBalancesResponse.XRPTokens, &models.XRPBalanceElem{
				Issuer:  elem["account"].(string),
				Balance: balanceFloat,
				Symbol:  elem["currency"].(string),
				//Price:   price,
				//Value:   value,
				Name: "token_name",
			})

		}
		return &xrpBalancesResponse, nil

	}
}

func (svc *XRPService) GetAccountTransactions(address string) (xrpl.BaseResponse, error) {

	transactionRequest := xrpl.BaseRequest{
		"id":               2,
		"command":          "account_tx",
		"account":          address,
		"ledger_index_min": -1,
		"ledger_index_max": -1,
		"binary":           false,
		"limit":            2,
		"forward":          false,
	}
	response, err := svc.client.Request(transactionRequest)
	fmt.Println(response, err)

	return response, err
}

func (svc *XRPService) GetDefiData(address string) (string, error) {

	transactions, err := svc.GetAccountTransactions(address)
	balances, err := svc.GetAccountBalances(address)
	fmt.Println(transactions, balances)
	return "success", err
}
