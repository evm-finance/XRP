type XRPService struct {
	xrpWssURL     string
	xrpDataApiURL string
	client        *xrpl.Client
}

type XRPInterface interface {
	GetClient(xrpWssUrl string) (*xrpl.Client, error)
	GetOffers(ledgerIndex int, offers int, client *xrpl.Client, currencySymbol string, currencyIssuer string) (*models.XRPInBookOfferResponse, error)
	GetAccountTransactions(address string)
	ConnectClient(xrpWssURL string) *xrpl.Client
	GetPriceFromClob(ledgerIndex int, currencySymbol string, currencyIssuer string) (*models.XRPInBookOfferResponse, error)
	GetTokenData(ledgerIndex int, client *xrpl.Client)
	StoreTokenData(ledgerIndex int, client *xrpl.Client)
	GetConnectionRedshift() (*gorm.DB, error)
}

func (svc *XRPService) GetConnectionRedshift() (*gorm.DB, error) {
	conf, err := configs.NewConfigRepo("../../.env")
	if err != nil {
		fmt.Println("error", err)
		return nil, err
	}
	db := conf.RedshiftDB()
	fmt.Println("db", db)

	return db, nil
}

func (svc *XRPService) ConnectClient(xrpWssURL string) *xrpl.Client {
	return xrpl.NewClient(xrpl.ClientConfig{URL: xrpWssURL, Timeout: 1, ConnectionTimeout: 10})
}

func (svc *XRPService) GetClient(xrpWssURL string) (*xrpl.Client, error) {
	client := svc.ConnectClient(xrpWssURL)
	err := client.Ping([]byte("PING"))
	if err != nil {
		return nil, err
	}

	return client, err
}

func (svc *XRPService) GetOffers(ledgerIndex int, offers int, client *xrpl.Client, currencySymbol string, currencyIssuer string) (*models.XRPInBookOfferResponse, error) {

	var result models.XRPInBookOfferResponse
	takerPays := models.XRPOfferObject{Currency: "XRP"}
	takerGets := models.CurrencyOfferObject{Currency: currencySymbol, Issuer: currencyIssuer}
	bookOfferRequest := models.XRPInBookOfferRequest{
		Id:        4,
		Command:   "book_offers",
		Taker:     "r9cZA1mLK5R5Am25ArfXFmqgNwjZgnfk59",
		TakerPays: takerPays,
		TakerGets: takerGets,
		Limit:     10,
	}

	request, err := json.Marshal(bookOfferRequest)
	var requestMap map[string]interface{}
	json.Unmarshal(request, &requestMap)
	fmt.Println(string(request))
	fmt.Println(err)
	sendRequest := xrpl.BaseRequest{
		"id":         4,
		"command":    "book_offers",
		"taker":      "rf1BiGeXwwQoi8Z2ueFYTEXSwuJYfV2Jpn",
		"taker_gets": takerGets,
		"taker_pays": takerPays,
		"limit":      offers,
	}
	fmt.Println(sendRequest)
	response, err := client.Request(sendRequest)
	if err != nil {
		return nil, err
	}
	jsonStr, err := json.Marshal(response)
	fmt.Println(string(jsonStr))
	if err != nil {
		return nil, err
	}
	if err := json.Unmarshal(jsonStr, &result); err != nil {
		return nil, err
	}
	if result.Status == "error" {
		return nil, fmt.Errorf("invalid Hash: %v", ledgerIndex)
	}
	fmt.Println(result)
	return &result, err
}

