func (svc *XRPService) GetLedgerData(ledgerIndex int, client *xrpl.Client) (*models.XRPLedger, error) {

	var result models.XRPLedgerResult
	request := xrpl.BaseRequest{
		"id":           1,
		"command":      "ledger",
		"ledger_index": ledgerIndex,
		"full":         false,
		"accounts":     false,
		"transactions": true,
		"expand":       true,
		"owner_funds":  false,
	}

	response, err := client.Request(request)
	if err != nil {
		return nil, err
	}
	jsonStr, err := json.Marshal(response)
	if err != nil {
		return nil, err
	}
	if err := json.Unmarshal(jsonStr, &result); err != nil {
		return nil, err
	}
	if result.Status == "error" {
		return nil, fmt.Errorf("invalid Hash: %v", ledgerIndex)
	}

	return result.Result, err
}

func (svc *XRPService) GetTransactionData(txHash string, client *xrpl.Client) (*models.XRPTransaction, error) {

	var result models.XRPTransactionResult

	request := xrpl.BaseRequest{"id": 1, "command": "tx", "transaction": txHash, "binary": false}

	response, err := client.Request(request)
	if err != nil {
		return nil, err
	}
	jsonStr, err := json.Marshal(response)
	if err != nil {
		return nil, err
	}
	if err := json.Unmarshal(jsonStr, &result); err != nil {
		return nil, err
	}

	return result.Result, err
}

func (svc *XRPService) GetLedger(ledgerHash string) (models.XRPLedgerResult, error) {
	var (
		url = svc.xrpDataApiURL + "/ledgers/?transactions=true" + ledgerHash
		r   models.XRPLedgerResult
	)
	bytes, err := utils.GetExternalAPIData(url)
	if err != nil {
		return r, err
	}
	if err = json.Unmarshal(bytes, &r); err != nil {
		return r, err
	}
	return r, nil
}

func (svc *XRPService) GetTransaction(txHash string) (models.XRPTransaction, error) {
	var (
		url = svc.xrpDataApiURL + "/transactions/" + txHash
		r   models.XRPTransaction
	)
	bytes, err := pkg.HttpRequest(http.MethodGet, url, nil)
	if err != nil {
		return r, err
	}
	if err = json.Unmarshal(bytes, &r); err != nil {
		return r, err
	}
	return r, nil
}

type QcData struct {
	// CoinSymbol string  `json:"coin_symbol"`
	CoinPrice float64 `json:"coin_price"`
}

type QcResponse struct {
	// Status QcStatus `json:"status"`
	Data QcData `json:"data"`
}

func (svc *XRPService) FetchQcPrice(symbol string) (price float64) {

	qc_api_key := "3F6TTBN3YLEG4P6IYSTY"
	qc_secret_key := "0U0Sikx06M9rMZjRQ7BnJ3Uxjc53Wsh07Kq4pL2h7IzuaJmP"
	url := "https://quantifycrypto.com/api/v1/coins/" + symbol + "?currency=USD&include_signals=false"
	method := "GET"
	var qcResponse QcResponse
	client := &http.Client{}
	req, err := http.NewRequest(method, url, nil)

	req.Header.Add("QC-Access-Key", qc_api_key)
	req.Header.Add("QC-Secret-Key", qc_secret_key)

	if err != nil {
		fmt.Printf("ERROR %s\n", err)
	}
	//r := make(map[string]interface{})
	//err = json.Unmarshal(data, &r)
	//fmt.Println(string(data))

	response, err := client.Do(req)
	if err != nil {
		fmt.Printf("The HTTP request failed with error %s\n", err)
	}
	data, err := io.ReadAll(response.Body)

	//fmt.Println(response.Body)
	//fmt.Println(string(data))
	//fmt.Println(response)

	if err != nil {
		fmt.Printf("ERROR %s\n", err)
	}

	//r := make(map[string]interface{})
	//err = json.Unmarshal(data, &r)
	//fmt.Println(string(data))

	json.Unmarshal(data, &qcResponse)

	fmt.Println(qcResponse.Data.CoinPrice)

	return qcResponse.Data.CoinPrice

}

