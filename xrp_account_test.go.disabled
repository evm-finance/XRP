package xrp

import (
	"fmt"
	"testing"

	"qc-defi-graphql-server/internal/models"
)

func newTestXRPService() *XRPService {
	svc := &XRPService{}
	return svc
}

func TestGetAccountBalances(t *testing.T) {
	service := newTestXRPService()
	balances, err := service.GetAccountBalances("rMjRc6Xyz5KHHDizJeVU63ducoaqWb1NSj")
	if err != nil {
		t.Errorf("GetAccountBalances failed: %v", err)
		return
	}

	fmt.Printf("Account: %s\n", balances.Account)
	fmt.Printf("XRP Balance: %f\n", balances.XRPBalance)
	fmt.Printf("XRP Price: %f\n", balances.XRPPrice)
	fmt.Printf("Number of tokens: %d\n", len(balances.XRPTokens))

	for i, token := range balances.XRPTokens {
		fmt.Printf("Token %d: %s (%s) - Balance: %f, Issuer: %s\n",
			i, token.Symbol, token.Name, token.Balance, token.Issuer)
	}
}

func TestGetAccountTransactions(t *testing.T) {
	service := newTestXRPService()
	response, err := service.GetAccountTransactions("rMjRc6Xyz5KHHDizJeVU63ducoaqWb1NSj")
	if err != nil {
		t.Errorf("GetAccountTransactions failed: %v", err)
		return
	}

	fmt.Printf("Transaction response: %+v\n", response)

	// Check if response contains expected fields
	if result, ok := response.(map[string]interface{}); ok {
		if account, ok := result["account"]; ok {
			fmt.Printf("Account: %s\n", account)
		}
		if transactions, ok := result["transactions"]; ok {
			if txList, ok := transactions.([]interface{}); ok {
				fmt.Printf("Number of transactions: %d\n", len(txList))
			}
		}
	}
}

func TestFetchQcPrice(t *testing.T) {
	service := newTestXRPService()
	price := service.FetchQcPrice("XRP")
	fmt.Printf("XRP Price: %f\n", price)

	if price <= 0 {
		t.Errorf("Expected positive XRP price, got %f", price)
	}
}

func TestGetAccountBalancesInvalidAddress(t *testing.T) {
	service := newTestXRPService()
	_, err := service.GetAccountBalances("invalid_address")
	if err == nil {
		t.Error("Expected error for invalid address, got nil")
	}
}

