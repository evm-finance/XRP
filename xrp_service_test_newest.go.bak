func TestGetAccountTransactions(t *testing.T) {

	client := xrpl.NewClient(xrpl.ClientConfig{URL: "wss://xrplcluster.com", Timeout: 1, ConnectionTimeout: 10})
	service := XRPService{xrpWssURL: "wss://xrplcluster.com", xrpDataApiURL: "https://data.ripple.com/v2", client: client}
	service.GetAccountTransactions("rMjRc6Xyz5KHHDizJeVU63ducoaqWb1NSj")

}

func TestGetAccountBalances(t *testing.T) {
	client := xrpl.NewClient(xrpl.ClientConfig{URL: "wss://xrplcluster.com", Timeout: 1, ConnectionTimeout: 10})
	service := XRPService{xrpWssURL: "wss://xrplcluster.com", xrpDataApiURL: "https://data.ripple.com/v2", client: client}
	service.GetAccountBalances("rMjRc6Xyz5KHHDizJeVU63ducoaqWb1NSj")
}

func TestXRPPrices(t *testing.T) {
	client := xrpl.NewClient(xrpl.ClientConfig{URL: "wss://xrplcluster.com", Timeout: 1, ConnectionTimeout: 10})
	service := XRPService{xrpWssURL: "wss://xrplcluster.com", xrpDataApiURL: "https://data.ripple.com/v2", client: client}
	service.GetAllPrices(0, client)
}

