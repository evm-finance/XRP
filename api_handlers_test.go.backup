package xrp

import (
	"fmt"
	"testing"
	"time"

	"github.com/shopspring/decimal"
	"gorm.io/gorm"
	"qc-defi-graphql-server/configs"
)

// APIHandlerTestSuite provides comprehensive testing for all API handlers
type APIHandlerTestSuite struct {
	config            *configs.ConfigRepo
	xrpDB             *gorm.DB
	xrpService        *XRPService
	screenerService   *ScreenerService
	ammService        AMMServiceInterface
	enhancedLedgerSvc *EnhancedLedgerService

	connMgr *ConnectionManager
}

// NewAPIHandlerTestSuite creates a new test suite with real database connections
func NewAPIHandlerTestSuite(t *testing.T) *APIHandlerTestSuite {
	// Load configuration
	conf, err := configs.NewConfigRepo("../../.env")
	if err != nil {
		t.Fatalf("❌ Failed to load config: %v", err)
	}

	// Get database connections
	xrpDB := conf.XRPDB()
	if xrpDB == nil {
		t.Fatalf("❌ Failed to get XRP database connection")
	}

	// Initialize XRPL connection manager
	xrplWssUrl := conf.EnvVars().RippleRpcClientWssUrl
	if xrplWssUrl == "" {
		xrplWssUrl = "wss://s1.ripple.com"
	}
	connMgr := NewConnectionManager(xrplWssUrl, 5, conf.Logger())

	// Initialize services
	xrpService := NewXRPServiceWithConnectionManager(connMgr)
	if err := xrpService.SetDatabase(xrpDB); err != nil {
		t.Fatalf("❌ Failed to set database on XRP service: %v", err)
	}

	screenerService := NewScreenerService(xrpDB)
	ammService := NewAMMService(xrpDB, connMgr)
	enhancedLedgerSvc := NewEnhancedLedgerService(xrpDB, connMgr, conf.RedisDB())

	return &APIHandlerTestSuite{
		config:            conf,
		xrpDB:             xrpDB,
		xrpService:        xrpService,
		screenerService:   screenerService,
		ammService:        ammService,
		enhancedLedgerSvc: enhancedLedgerSvc,
		connMgr:           connMgr,
	}
}

// TestTokensEndpoint tests the /api/xrp/tokens endpoint handler logic
func TestTokensEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Tokens Endpoint Handler")
	t.Log("=================================")

	// Test the actual service method that the handler calls
	tokens, err := suite.xrpService.GetTokenList()
	if err != nil {
		t.Errorf("❌ GetTokenList failed: %v", err)
		return
	}

	t.Logf("✅ Retrieved %d tokens from database", len(tokens))

	// Validate token data structure
	if len(tokens) > 0 {
		token := tokens[0]
		t.Logf("📊 Sample token: %s (%s)", token.TokenName, token.Currency)
		t.Logf("   Price: $%.6f", token.Price)
		t.Logf("   Market Cap: $%.2f", token.Marketcap)
		t.Logf("   Supply: %.2f", token.Supply)

		// Validate required fields
		if token.Currency == "" {
			t.Error("❌ Token missing currency")
		}
		if token.IssuerAddress == "" && token.Currency != "XRP" {
			t.Error("❌ Non-XRP token missing issuer address")
		}
	}

	// Test database query performance
	start := time.Now()
	_, err = suite.xrpService.GetTokenList()
	duration := time.Since(start)

	if duration > 500*time.Millisecond {
		t.Logf("⚠️  Slow query: %v (consider optimization)", duration)
	} else {
		t.Logf("⚡ Fast query: %v", duration)
	}
}

// TestScreenerEndpoint tests the /api/xrp/screener endpoint handler logic
func TestScreenerEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Screener Endpoint Handler")
	t.Log("===================================")

	// Test the actual screener service method
	screenerData, err := suite.screenerService.GetOptimizedScreenerData(50, 0)
	if err != nil {
		t.Errorf("❌ GetOptimizedScreenerData failed: %v", err)
		return
	}

	t.Logf("✅ Retrieved %d screener tokens", len(screenerData))

	// Validate screener data quality
	tokensWithPrices := 0
	for _, token := range screenerData {
		if token.Price > 0 {
			tokensWithPrices++
		}
	}

	priceSuccessRate := float64(tokensWithPrices) / float64(len(screenerData)) * 100
	t.Logf("💰 Tokens with prices: %d/%d (%.1f%%)", tokensWithPrices, len(screenerData), priceSuccessRate)

	if priceSuccessRate < 10 {
		t.Error("❌ Low price success rate - screener may need debugging")
	}

	// Test pagination
	page2Data, err := suite.screenerService.GetOptimizedScreenerData(50, 50)
	if err != nil {
		t.Errorf("❌ Pagination test failed: %v", err)
	} else {
		t.Logf("✅ Pagination working: page 2 has %d tokens", len(page2Data))
	}
}

// TestAMMPoolsEndpoint tests the /api/xrp/amm/pools endpoint handler logic
func TestAMMPoolsEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing AMM Pools Endpoint Handler")
	t.Log("====================================")

	// Test getting all AMM pools
	pools, err := suite.ammService.GetAllAMMPools()
	if err != nil {
		t.Errorf("❌ GetAllAMMPools failed: %v", err)
		return
	}

	t.Logf("✅ Retrieved %d AMM pools from database", len(pools))

	// Validate pool data
	if len(pools) > 0 {
		pool := pools[0]
		t.Logf("📊 Sample pool: %s", pool.Account)
		t.Logf("   Asset1: %s %s", pool.Asset1Amount, pool.Asset1Currency)
		t.Logf("   Asset2: %s %s", pool.Asset2Amount, pool.Asset2Currency)
		t.Logf("   Liquidity: $%.2f", pool.LiquidityUSD)

		// Validate required fields
		if pool.Account == "" {
			t.Error("❌ Pool missing account")
		}
		if pool.Asset1Currency == "" {
			t.Error("❌ Pool missing asset1 currency")
		}
	}

	// Test top pools functionality
	topPools, err := suite.ammService.GetTopAMMPools(10)
	if err != nil {
		t.Errorf("❌ GetTopAMMPools failed: %v", err)
	} else {
		t.Logf("✅ Top pools query returned %d pools", len(topPools))
	}
}

// TestTransactionEndpoint tests the /api/xrp/transaction/{hash} endpoint handler logic
func TestTransactionEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Transaction Endpoint Handler")
	t.Log("======================================")

	// Get a sample transaction hash from the database first
	var sampleHash string
	err := suite.xrpDB.Raw("SELECT hash FROM xrpTransactions WHERE hash IS NOT NULL AND hash != '' LIMIT 1").Scan(&sampleHash).Error
	if err != nil || sampleHash == "" {
		t.Log("⚠️  No transaction hashes in database - testing with dummy hash")
		sampleHash = "1234567890ABCDEF"
	}

	t.Logf("🔍 Testing with transaction hash: %s", sampleHash)

	// Test the transaction retrieval logic
	transaction, err := suite.xrpService.GetTransaction(sampleHash)
	if err != nil {
		t.Logf("⚠️  GetTransaction failed (expected if hash doesn't exist): %v", err)
	} else {
		t.Logf("✅ Transaction retrieved: %+v", transaction)
	}

	// Test with a known invalid hash
	_, err = suite.xrpService.GetTransaction("invalid_hash")
	if err == nil {
		t.Error("❌ Expected error for invalid hash but got success")
	} else {
		t.Logf("✅ Properly handled invalid hash: %v", err)
	}
}

// TestLedgerEndpoint tests the /api/xrp/ledger/{id} endpoint handler logic
func TestLedgerEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Ledger Endpoint Handler")
	t.Log("=================================")

	// Get current ledger index
	currentLedger, err := suite.enhancedLedgerSvc.GetCurrentLedgerIndex()
	if err != nil {
		t.Errorf("❌ Failed to get current ledger index: %v", err)
		return
	}

	t.Logf("📊 Current ledger index: %d", currentLedger)

	// Test getting recent ledger
	testLedgerIndex := currentLedger - 1
	ledger, err := suite.enhancedLedgerSvc.GetLedger(testLedgerIndex)
	if err != nil {
		t.Errorf("❌ GetLedger failed for index %d: %v", testLedgerIndex, err)
	} else {
		t.Logf("✅ Ledger %d retrieved successfully", testLedgerIndex)
		t.Logf("   Hash: %s", ledger.LedgerHash)
		t.Logf("   Close Time: %s", ledger.CloseTime)
		t.Logf("   Transaction Count: %d", ledger.TransactionCount)
	}

	// Test getting ledger transactions
	transactions, err := suite.enhancedLedgerSvc.GetLedgerTransactions(testLedgerIndex, 10)
	if err != nil {
		t.Errorf("❌ GetLedgerTransactions failed: %v", err)
	} else {
		t.Logf("✅ Retrieved %d transactions from ledger %d", len(transactions), testLedgerIndex)
	}
}

// TestAccountBalancesEndpoint tests the account balances endpoint handler logic
func TestAccountBalancesEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Account Balances Endpoint Handler")
	t.Log("===========================================")

	// Test with a known XRP address
	testAddress := "rMV5cxLAKs8SuoZ8Ly8geDSnXgf9gui6Fo"

	balances, err := suite.xrpService.GetAccountBalances(testAddress)
	if err != nil {
		t.Errorf("❌ GetAccountBalances failed for %s: %v", testAddress, err)
		return
	}

	t.Logf("✅ Account balances retrieved for %s", testAddress)
	t.Logf("   XRP Balance: %s", balances.XRPBalance)
	t.Logf("   XRP Price: $%.6f", balances.XRPPrice)
	t.Logf("   Token Count: %d", len(balances.XRPTokens))

	// Validate balance data
	if balances.Account != testAddress {
		t.Errorf("❌ Account mismatch: expected %s, got %s", testAddress, balances.Account)
	}

	if balances.XRPPrice <= 0 {
		t.Error("❌ Invalid XRP price")
	}

	// Test with invalid address
	_, err = suite.xrpService.GetAccountBalances("invalid_address")
	if err == nil {
		t.Error("❌ Expected error for invalid address but got success")
	} else {
		t.Logf("✅ Properly handled invalid address: %v", err)
	}
}

// TestPriceEndpoint tests the /api/xrp/price endpoint handler logic
func TestPriceEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Price Endpoint Handler")
	t.Log("================================")

	// Test XRP price calculation
	priceService := NewPriceServiceWithDBAndConn(suite.xrpDB, suite.connMgr)

	xrpPrice, err := priceService.GetXRPLPrice()
	if err != nil {
		t.Errorf("❌ GetXRPLPrice failed: %v", err)
		return
	}

	t.Logf("✅ XRP Price: $%.6f", xrpPrice)

	if xrpPrice.LessThanOrEqual(decimal.Zero) {
		t.Error("❌ XRP price should be greater than 0")
	}

	if xrpPrice.GreaterThan(decimal.NewFromFloat(100)) {
		t.Error("❌ XRP price seems unreasonably high")
	}

	// Test token price calculation
	testCurrency := "MAG"
	testIssuer := "rXmagwMmnFtVet3uL26Q2iwk287SRvVMJ"

	tokenPrice, err := priceService.GetTokenPriceViaTwoStepConversion(testCurrency, testIssuer)
	if err != nil {
		t.Logf("⚠️  Token price calculation failed (may not have AMM pool): %v", err)
	} else {
		t.Logf("✅ %s price: $%.6f", testCurrency, tokenPrice)
	}
}

// TestAMMUpdateStatusEndpoint tests the AMM update status endpoint
func TestAMMUpdateStatusEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing AMM Update Status Endpoint")
	t.Log("====================================")

	// Create AMM update job to test status
	priceService := NewPriceServiceWithDBAndConn(suite.xrpDB, suite.connMgr)
	priceCollector := NewAMMPriceCollector(suite.xrpDB, suite.ammService.(*AMMService), priceService)
	ammUpdateJob := NewSimpleAMMUpdateJob(suite.xrpDB, suite.ammService.(*AMMService), priceCollector, 2*time.Minute)

	// Start the job
	if err := ammUpdateJob.Start(); err != nil {
		t.Errorf("❌ Failed to start AMM update job: %v", err)
		return
	}

	// Get status
	stats := ammUpdateJob.GetStats()
	t.Logf("✅ AMM Update Job Status:")
	t.Logf("   Running: %v", stats.Running)
	t.Logf("   Update Count: %d", stats.UpdateCount)
	t.Logf("   Error Count: %d", stats.ErrorCount)
	t.Logf("   Update Interval: %v", stats.UpdateInterval)

	// Stop the job
	if err := ammUpdateJob.Stop(); err != nil {
		t.Errorf("⚠️  Failed to stop AMM update job: %v", err)
	}
}

