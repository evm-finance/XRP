// Helper function to run all comprehensive tests
func TestAllAPIHandlers(t *testing.T) {
	t.Log("🚀 Running Comprehensive API Handler Test Suite")
	t.Log("===============================================")

	// Run all test categories
	t.Run("TokensEndpoint", TestTokensEndpoint)
	t.Run("ScreenerEndpoint", TestScreenerEndpoint)
	t.Run("AMMPoolsEndpoint", TestAMMPoolsEndpoint)
	t.Run("TransactionEndpoint", TestTransactionEndpoint)
	t.Run("LedgerEndpoint", TestLedgerEndpoint)
	t.Run("AccountBalancesEndpoint", TestAccountBalancesEndpoint)
	t.Run("PriceEndpoint", TestPriceEndpoint)
	t.Run("AMMUpdateStatusEndpoint", TestAMMUpdateStatusEndpoint)
	t.Run("ScreenerUpdateStatusEndpoint", TestScreenerUpdateStatusEndpoint)
	t.Run("TopAMMPoolsEndpoint", TestTopAMMPoolsEndpoint)
	t.Run("HealthCheckEndpoint", TestHealthCheckEndpoint)
	t.Run("MonitoringEndpoints", TestMonitoringEndpoints)
	t.Run("UserPositionsEndpoint", TestUserPositionsEndpoint)
	t.Run("NetworkInfoEndpoint", TestNetworkInfoEndpoint)

	t.Log("\n🎉 All API Handler Tests Completed!")
}

// TestSpecificTokenEndpoint tests individual token endpoint with real production scenarios
func TestSpecificTokenEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Specific Token Endpoint Handler (Production Issues)")
	t.Log("=============================================================")

	// Test the ARMY token that's causing 500 errors in production
	testCurrency := "ARMY"
	testIssuer := "rGG3wQ4kUzd7Jnmk1n5NWPZjjut62kCBfC"

	t.Logf("🔍 Testing problematic token: %s/%s", testCurrency, testIssuer)

	// First, check if this token exists in our database
	var tokenExists bool
	err := suite.xrpDB.Raw(`
		SELECT EXISTS(
			SELECT 1 FROM xrpTokens 
			WHERE currency = ? AND issuer = ?
		) as token_exists
	`, testCurrency, testIssuer).Scan(&tokenExists).Error

	if err != nil {
		t.Errorf("❌ Database query to check token existence failed: %v", err)
		return
	}

	t.Logf("📊 Token %s/%s exists in database: %v", testCurrency, testIssuer, tokenExists)

	// Test the actual service method that the endpoint calls
	var token struct {
		Currency    string  `json:"currency"`
		Issuer      string  `json:"issuer"`
		Name        string  `json:"name"`
		Description string  `json:"description"`
		Supply      string  `json:"supply"`
		Trustlines  int64   `json:"trustlines"`
		Holders     int64   `json:"holders"`
		Price       float64 `json:"price"`
		MarketCap   float64 `json:"marketcap"`
		Volume24h   float64 `json:"volume24h"`
		Volume7d    float64 `json:"volume7d"`
		Icon        string  `json:"icon"`
		Weblinks    string  `json:"weblinks"`
	}

	// This is the exact query from the endpoint handler
	query := `
		SELECT currency, issuer, token_name as name, description, supply_xrpl as supply, trustlines, holders, 
			   price, marketcap, volume_24h as volume24h, volume_24h as volume7d, icon, weblinks
		FROM xrpTokens 
		WHERE currency = ? AND issuer = ?
	`

	err = suite.xrpDB.Raw(query, testCurrency, testIssuer).Scan(&token).Error
	if err != nil {
		t.Logf("❌ Database query failed (this reproduces the 500 error): %v", err)

		// Let's diagnose what's wrong with the query
		t.Log("🔍 Diagnosing database schema issues...")

		// Check what columns actually exist in xrpTokens table
		var columns []struct {
			ColumnName string `gorm:"column:COLUMN_NAME"`
		}

		err = suite.xrpDB.Raw(`
			SELECT COLUMN_NAME 
			FROM INFORMATION_SCHEMA.COLUMNS 
			WHERE TABLE_NAME = 'xrpTokens' AND TABLE_SCHEMA = DATABASE()
			ORDER BY ORDINAL_POSITION
		`).Scan(&columns).Error

		if err != nil {
			t.Errorf("❌ Failed to get table schema: %v", err)
		} else {
			t.Log("📋 Actual xrpTokens table columns:")
			for _, col := range columns {
				t.Logf("   - %s", col.ColumnName)
			}
		}

		// Check if ARMY token exists with any column name variations
		var searchResults []struct {
			Currency string `json:"currency"`
			Issuer   string `json:"issuer"`
			Name     string `json:"token_name"`
		}

		err = suite.xrpDB.Raw(`
			SELECT currency, issuer, token_name
			FROM xrpTokens 
			WHERE currency LIKE '%ARMY%' OR token_name LIKE '%ARMY%'
			LIMIT 5
		`).Scan(&searchResults).Error

		if err != nil {
			t.Errorf("❌ Failed to search for ARMY token: %v", err)
		} else {
			t.Logf("🔍 ARMY token search results (%d found):", len(searchResults))
			for _, result := range searchResults {
				t.Logf("   Currency: %s, Issuer: %s, Name: %s", result.Currency, result.Issuer, result.Name)
			}
		}

	} else {
		t.Logf("✅ Token query successful: %+v", token)

		// Validate token data
		if token.Currency == "" {
			t.Error("❌ Token currency is empty")
		}
		if token.Issuer == "" {
			t.Error("❌ Token issuer is empty")
		}
	}

	// Test other problematic currency formats
	testCases := []struct {
		name     string
		currency string
		issuer   string
	}{
		{"XRP Native", "XRP", ""},
		{"USD Ripple", "USD", "rhub8VRN55s94qWKDv6jmDy1pUykJzF3wq"},
		{"Hex Currency", "41524D5900000000000000000000000000000000", "rGG3wQ4kUzd7Jnmk1n5NWPZjjut62kCBfC"},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			var testToken struct {
				Currency string `json:"currency"`
				Issuer   string `json:"issuer"`
			}

			query := "SELECT currency, issuer FROM xrpTokens WHERE currency = ? AND issuer = ?"
			err := suite.xrpDB.Raw(query, tc.currency, tc.issuer).Scan(&testToken).Error

			if err != nil {
				t.Logf("⚠️  Query failed for %s: %v", tc.name, err)
			} else {
				t.Logf("✅ Found token for %s: %s/%s", tc.name, testToken.Currency, testToken.Issuer)
			}
		})
	}
}
