// TestTopAMMPoolsEndpoint tests the /api/xrp/amm/top-pools endpoint handler logic
func TestTopAMMPoolsEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Top AMM Pools Endpoint Handler")
	t.Log("========================================")

	// Test getting top pools
	topPools, err := suite.ammService.GetTopAMMPools(10)
	if err != nil {
		t.Errorf("❌ GetTopAMMPools failed: %v", err)
		return
	}

	t.Logf("✅ Retrieved %d top AMM pools", len(topPools))

	// Validate pool data
	if len(topPools) > 0 {
		pool := topPools[0]
		t.Logf("📊 Top pool: %s", pool.Account)
		t.Logf("   Liquidity: $%.2f", pool.LiquidityUSD)
		t.Logf("   Trading Fee: %d", pool.TradingFee)

		// Validate liquidity ordering (should be descending)
		if len(topPools) > 1 {
			if topPools[0].LiquidityUSD < topPools[1].LiquidityUSD {
				t.Error("❌ Top pools not properly ordered by liquidity")
			} else {
				t.Log("✅ Pools properly ordered by liquidity")
			}
		}
	}

	// Test with different limits
	smallList, err := suite.ammService.GetTopAMMPools(3)
	if err != nil {
		t.Errorf("❌ GetTopAMMPools with limit 3 failed: %v", err)
	} else {
		t.Logf("✅ Limited query returned %d pools", len(smallList))
		if len(smallList) > 3 {
			t.Error("❌ Limit not respected")
		}
	}
}

// TestHealthCheckEndpoint tests the health check endpoints
func TestHealthCheckEndpoint(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Health Check Endpoint Handler")
	t.Log("=======================================")

	// Test database connectivity
	err := suite.xrpDB.Exec("SELECT 1").Error
	if err != nil {
		t.Errorf("❌ Database health check failed: %v", err)
	} else {
		t.Log("✅ Database connection healthy")
	}

	// Test table existence
	tables := []string{"xrpTokens", "xrpAmm_normalized", "xrpScreener", "xrpTransactions", "xrpLedgers"}
	for _, table := range tables {
		var count int64
		err := suite.xrpDB.Table(table).Count(&count).Error
		if err != nil {
			t.Errorf("❌ Table %s not accessible: %v", table, err)
		} else {
			t.Logf("✅ Table %s: %d records", table, count)
		}
	}

	// Test XRPL connection
	_, err = suite.connMgr.GetConnection()
	if err != nil {
		t.Errorf("❌ XRPL connection failed: %v", err)
	} else {
		t.Log("✅ XRPL connection healthy")
	}
}

// TestMonitoringEndpoints tests the monitoring endpoints
func TestMonitoringEndpoints(t *testing.T) {
	suite := NewAPIHandlerTestSuite(t)

	t.Log("🧪 Testing Monitoring Endpoints")
	t.Log("==============================")

	// Test getting current system status
	t.Log("📊 System Status Check:")

	// Check database responsiveness
	start := time.Now()
	var dbTime string
	err := suite.xrpDB.Raw("SELECT NOW()").Scan(&dbTime).Error
	dbDuration := time.Since(start)

	if err != nil {
		t.Errorf("❌ Database response check failed: %v", err)
	} else {
		t.Logf("✅ Database response time: %v", dbDuration)
	}

	// Check recent activity
	var recentActivity struct {
		RecentTransactions int64 `gorm:"column:recent_transactions"`
		RecentLedgers      int64 `gorm:"column:recent_ledgers"`
		RecentAMMUpdates   int64 `gorm:"column:recent_amm_updates"`
	}

	suite.xrpDB.Raw(`
		SELECT 
			(SELECT COUNT(*) FROM xrpTransactions WHERE created_at > DATE_SUB(NOW(), INTERVAL 1 HOUR)) as recent_transactions,
			(SELECT COUNT(*) FROM xrpLedgers WHERE created_at > DATE_SUB(NOW(), INTERVAL 1 HOUR)) as recent_ledgers,
			(SELECT COUNT(*) FROM xrpAmm_normalized WHERE last_updated > UNIX_TIMESTAMP() - 3600) as recent_amm_updates
	`).Scan(&recentActivity)

	t.Logf("📈 Recent Activity (last hour):")
	t.Logf("   Transactions: %d", recentActivity.RecentTransactions)
	t.Logf("   Ledgers: %d", recentActivity.RecentLedgers)
	t.Logf("   AMM Updates: %d", recentActivity.RecentAMMUpdates)
}

